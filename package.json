{
  "name": "cleanmusic",
  "productName": "CleanMusic",
  "version": "1.13.0",
  "private": true,
  "description": "CleanMusic – The Music Launcher. Alle Streaming-Dienste an einem Ort, lokale Wiedergabe, Favoriten, Playlists, Cutter-Modus, Vollbild-Player mit Visualizer, Discord Rich Presence und optionale Quellen-Plugins.",
  "author": "CleanMusic",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "smoke:plugin": "electron . --smoke --smoke-plugin",
    "smoke:obs": "electron . --smoke --smoke-obs",
    "smoke:streamerbot": "electron . --smoke --smoke-streamerbot",
    "smoke:update": "electron . --smoke --smoke-update",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --win dir",
    "icons": "electron tools/make-icons.js",
    "smoke:update-setup": "electron . --smoke --smoke-update --smoke-update-setup"
  },
  "build": {
    "appId": "de.cleanmusic.launcher",
    "productName": "CleanMusic",
    "copyright": "Copyright © 2026 CleanMusic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "preload-mini.js",
      "discord-rpc.js",
      "renderer/live-bg.js",
      "renderer/**/*",
      "renderer/remote/**/*",
      "renderer/mini.html",
      "renderer/mini.js",
      "renderer/assets/thumbar/*.png",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user",
      "artifactName": "CleanMusic-${version}-portable.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CleanMusic-${version}.${ext}",
      "category": "AudioVideo",
      "synopsis": "The Music Launcher",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "CleanMusic-${version}-setup.${ext}",
      "shortcutName": "CleanMusic",
      "uninstallDisplayName": "CleanMusic",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "protocols": [
      {
        "name": "CleanMusic",
        "schemes": [
          "cleanmusic"
        ]
      }
    ]
  },
  "dependencies": {
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
