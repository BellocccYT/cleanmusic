{
  "name": "cleanmusic",
  "productName": "CleanMusic",
  "version": "0.12.0",
  "private": true,
  "description": "CleanMusic – The Music Launcher. Alle Streaming-Dienste an einem Ort, lokale Wiedergabe, Favoriten, Playlists, Cutter-Modus, Vollbild-Player mit Visualizer, Discord Rich Presence und optionale Quellen-Plugins.",
  "author": "CleanMusic",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "smoke": "electron . --smoke",
    "smoke:plugin": "electron . --smoke --smoke-plugin",
    "smoke:obs": "electron . --smoke --smoke-obs",
    "smoke:streamerbot": "electron . --smoke --smoke-streamerbot",
    "smoke:update": "electron . --smoke --smoke-update",
    "build:win": "electron-builder --win portable",
    "build:linux": "electron-builder --linux AppImage",
    "build:dir": "electron-builder --win dir",
    "icons": "electron tools/make-icons.js"
  },
  "build": {
    "appId": "de.cleanmusic.launcher",
    "productName": "CleanMusic",
    "copyright": "Copyright © 2026 CleanMusic",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "discord-rpc.js",
      "renderer/**/*",
      "package.json",
      "LICENSE",
      "THIRD-PARTY-NOTICES.md"
    ],
    "asar": true,
    "compression": "normal",
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CleanMusic-${version}-portable.${ext}",
      "icon": "build/icon.ico"
    },
    "portable": {
      "requestExecutionLevel": "user"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "CleanMusic-${version}.${ext}",
      "category": "AudioVideo",
      "synopsis": "The Music Launcher",
      "icon": "build/icon.png"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^26.18.0"
  }
}
